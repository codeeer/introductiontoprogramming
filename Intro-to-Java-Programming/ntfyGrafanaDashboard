        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(ntfy_http_requests_total{http_code=~\"4..\", job=~\"$job\"}[5m])) / clamp_min(sum(rate(ntfy_http_requests_total{job=~\"$job\"}[5m])), 1)",
          "legendFormat": "4xx %"
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(ntfy_http_requests_total{http_code=~\"5..\", job=~\"$job\"}[5m])) / clamp_min(sum(rate(ntfy_http_requests_total{job=~\"$job\"}[5m])), 1)",
          "legendFormat": "5xx %"
