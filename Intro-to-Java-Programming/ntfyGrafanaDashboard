{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "ntfy metriklerini scrape eden Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "ntfy - Sunucu Metrikleri",
  "uid": "ntfy-server-metrics",
  "tags": ["ntfy", "prometheus", "notifications"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(ntfy_http_requests_total, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "YayÄ±nlanan Mesaj (toplam)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(ntfy_messages_published_success{instance=~\"$instance\"})", "legendFormat": "BaÅarÄ±lÄ±" }
      ]
    },
    {
      "type": "stat",
      "title": "YayÄ±n HatasÄ± (toplam)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(ntfy_messages_published_failure{instance=~\"$instance\"})", "legendFormat": "Hata" }
      ]
    },
    {
      "type": "stat",
      "title": "Aktif Abone",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(ntfy_subscribers_total{instance=~\"$instance\"})", "legendFormat": "Abone" }
      ]
    },
    {
      "type": "stat",
      "title": "Topic SayÄ±sÄ±",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "purple", "value": null } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(ntfy_topics_total{instance=~\"$instance\"})", "legendFormat": "Topic" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mesaj YayÄ±n HÄ±zÄ± (msg/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" }, "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ntfy_messages_published_success{instance=~\"$instance\"}[5m]))", "legendFormat": "BaÅarÄ±lÄ±" },
        { "refId": "B", "expr": "sum(rate(ntfy_messages_published_failure{instance=~\"$instance\"}[5m]))", "legendFormat": "Hata" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Ä°stek HÄ±zÄ± (kod bazÄ±nda)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "stacking": { "mode": "normal" }, "showPoints": "never" }, "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (http_code) (rate(ntfy_http_requests_total{instance=~\"$instance\"}[5m]))", "legendFormat": "{{http_code}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Hata OranÄ± (5xx %)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15, "showPoints": "never" }, "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "expr": "100 * sum(rate(ntfy_http_requests_total{http_code=~\"5..\", instance=~\"$instance\"}[5m])) / clamp_min(sum(rate(ntfy_http_requests_total{instance=~\"$instance\"}[5m])), 1)", "legendFormat": "5xx %" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mesaj YayÄ±n SÃ¼resi (ms)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" }, "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "expr": "max(ntfy_message_publish_duration_ms{instance=~\"$instance\"})", "legendFormat": "publish ms" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Visitor / User / Cached Mesaj",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 5, "showPoints": "never" }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(ntfy_visitors_total{instance=~\"$instance\"})", "legendFormat": "Visitor" },
        { "refId": "B", "expr": "sum(ntfy_users_total{instance=~\"$instance\"})", "legendFormat": "User" },
        { "refId": "C", "expr": "sum(ntfy_messages_cached_total{instance=~\"$instance\"})", "legendFormat": "Cached" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kanal BazÄ±nda GÃ¶nderim HÄ±zÄ± (Email / Call / Firebase / UnifiedPush / Matrix)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "showPoints": "never" }, "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ntfy_emails_sent_success{instance=~\"$instance\"}[5m]))", "legendFormat": "Email OK" },
        { "refId": "B", "expr": "sum(rate(ntfy_emails_sent_failure{instance=~\"$instance\"}[5m]))", "legendFormat": "Email Hata" },
        { "refId": "C", "expr": "sum(rate(ntfy_calls_made_success{instance=~\"$instance\"}[5m]))", "legendFormat": "Call OK" },
        { "refId": "D", "expr": "sum(rate(ntfy_calls_made_failure{instance=~\"$instance\"}[5m]))", "legendFormat": "Call Hata" },
        { "refId": "E", "expr": "sum(rate(ntfy_firebase_published_success{instance=~\"$instance\"}[5m]))", "legendFormat": "Firebase OK" },
        { "refId": "F", "expr": "sum(rate(ntfy_firebase_published_failure{instance=~\"$instance\"}[5m]))", "legendFormat": "Firebase Hata" },
        { "refId": "G", "expr": "sum(rate(ntfy_unifiedpush_published_success{instance=~\"$instance\"}[5m]))", "legendFormat": "UnifiedPush OK" },
        { "refId": "H", "expr": "sum(rate(ntfy_matrix_published_success{instance=~\"$instance\"}[5m]))", "legendFormat": "Matrix OK" },
        { "refId": "I", "expr": "sum(rate(ntfy_matrix_published_failure{instance=~\"$instance\"}[5m]))", "legendFormat": "Matrix Hata" }
      ]
    }
  ]
}